# Deployed website image. Build context is the repo root:
#   fly deploy --config apps/web/fly.staging.toml .
FROM node:22-slim AS build
WORKDIR /repo
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 NEXT_TELEMETRY_DISABLED=1 NEXT_OUTPUT=standalone
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter @propperbrew/web...
# NEXT_PUBLIC_* are compiled into the browser code, so they're set at build time (fly.*.toml [build.args]).
# The home, roaster and coffee pages are prerendered from the API, so it must be deployed and reachable first.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SITE_URL
RUN test -n "$NEXT_PUBLIC_API_URL" && test -n "$NEXT_PUBLIC_SUPABASE_URL" && test -n "$NEXT_PUBLIC_SUPABASE_ANON_KEY" && test -n "$NEXT_PUBLIC_SITE_URL" \
  || (echo "Set the NEXT_PUBLIC_* build args" && exit 1)
RUN pnpm --filter @propperbrew/web build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
# Next's self-contained server, with only the dependencies it uses.
COPY --from=build --chown=node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node /repo/apps/web/.next/static ./apps/web/.next/static
USER node
EXPOSE 8080
CMD ["node", "apps/web/server.js"]
