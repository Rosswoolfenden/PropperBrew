# --- Database (supabase start prints these) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase auth (JWT verification in the API) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# For "Continue with Shopify" (creating accounts via the auth admin API). Optional locally:
# the API derives one from SUPABASE_JWT_SECRET.
SUPABASE_SERVICE_ROLE_KEY=

# --- API ---
PORT=4000
PUBLIC_API_URL=http://localhost:4000
# The website, where Shopify connect / sign-in send people back to.
PUBLIC_WEB_URL=http://localhost:3000
# 32 bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Shopify app (Partners dashboard -> your app -> Client credentials) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,write_orders,read_orders,read_fulfillments,read_shipping

# --- Claude (bean enrichment + bag scanner) ---
ANTHROPIC_API_KEY=

# In-app checkout (Stripe Connect). Leave both empty to send buyers to each roaster's Shopify store.
# Use test keys (sk_test_...) until you're live. The webhook secret comes from the Stripe dashboard
# (endpoint: <PUBLIC_API_URL>/stripe/webhook) or `stripe listen --forward-to localhost:4000/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Clients ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Any value works against the local auth service; use the project's anon key in production.
EXPO_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
